rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Private CV uploads: users/{uid}/documents/{file}, max 10 MB, documents only.
    match /users/{uid}/documents/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|text/plain|text/markdown|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
