{
  "manifest_version": 3,
  "name": "FormPilot",
  "short_name": "FormPilot",
  "version": "0.1.0",
  "description": "Your information. Every form. Handled. AI drafts answers from your profile; you review, approve and submit.",
  "action": { "default_title": "Open FormPilot", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "minimum_chrome_version": "116"
}
