# --- Public (safe in the browser) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server only (Netlify environment variables; never shipped to the browser/extension) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-haiku-5-5
MONTHLY_GENERATION_LIMIT=300   # fields answered by AI per user per month

# --- Extension build ---
FORMPILOT_APP_URL=https://your-formpilot-site.netlify.app
