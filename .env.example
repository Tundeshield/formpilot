# --- Firebase web config (public; Firebase console → Project settings → Your apps → Web app) ---
# Used by the dashboard build AND read by the Netlify functions.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_APP_ID=

# --- Server only (Netlify environment variables; never shipped to the browser/extension) ---
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-haiku-5-5
MONTHLY_GENERATION_LIMIT=300   # fields answered by AI per user per month

# --- Extension build (optional; on Netlify the site URL is used automatically) ---
# FORMPILOT_APP_URL=https://your-formpilot-site.netlify.app
